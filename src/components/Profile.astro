---
import { profile } from '../data/site';
---

<div class="flex flex-col gap-6 items-center text-center sm:items-start sm:text-left">

    <div>

        <h1 class="text-2xl font-extrabold mb-1 inline-block relative ui-text">
            {profile.name}
        </h1>

        <p
            class="text-sm mb-2 text-primary"
            data-i18n-field
            data-en={profile.title.en}
            data-mn={profile.title.mn}
        >
            {profile.title.en}
        </p>

        <p
            class="flex items-center justify-center sm:justify-start text-sm ui-muted"
            data-i18n-field
            data-en={profile.location.en}
            data-mn={profile.location.mn}
        >
            <svg class="-mt-0.5 inline mr-2" fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" xmlns="http://www.w3.org/2000/svg"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            {profile.location.en}
        </p>

    </div>

    <p
        class="text-sm leading-relaxed mt-4 ui-muted"
        data-i18n-field
        data-en={profile.description.en}
        data-mn={profile.description.mn}
    >
        {profile.description.en}
    </p>

</div>
