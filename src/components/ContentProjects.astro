---
import { projects, uiCopy } from '../data/site';
---

<div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        {projects.map(project =>

            <div class="flex flex-col justify-center items-start border ui-border rounded-lg p-4 ui-panel-soft">

                <h3
                    class="text-xl font-semibold ui-text mb-2"
                    data-i18n-field
                    data-en={project.name.en}
                    data-mn={project.name.mn}
                >
                    {project.name.en}
                </h3>

                <p
                    class="ui-muted"
                    data-i18n-field
                    data-en={project.description.en}
                    data-mn={project.description.mn}
                >
                    {project.description.en}
                </p>

                <div class="mt-4 flex w-full flex-col gap-2 sm:flex-row">

                {
                    project.websiteUrl ?
                        <a
                            href={project.websiteUrl}
                            title={project.name.en}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full px-4 py-2.5 text-center border ui-border rounded-lg ui-text hover:text-primary hover:border-primary">
                            <span data-i18n-field data-en={uiCopy.projectWebsite.en} data-mn={uiCopy.projectWebsite.mn}>{uiCopy.projectWebsite.en}</span>
                        </a>
                    : null
                }

                {
                    project.sourceUrl ?
                        <a
                            href={project.sourceUrl}
                            title={project.name.en + ' source code'}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-full px-4 py-2.5 text-center border ui-border rounded-lg ui-text hover:text-primary hover:border-primary">
                            <span data-i18n-field data-en={uiCopy.projectSource.en} data-mn={uiCopy.projectSource.mn}>{uiCopy.projectSource.en}</span>
                        </a>
                    :
                        <span class="w-full px-4 py-2.5 text-center border ui-border rounded-lg ui-muted opacity-70 cursor-not-allowed">
                            <span data-i18n-field data-en={uiCopy.projectSourcePrivate.en} data-mn={uiCopy.projectSourcePrivate.mn}>{uiCopy.projectSourcePrivate.en}</span>
                        </span>
                }

                </div>

            </div>

        )}

    </div>

</div>
