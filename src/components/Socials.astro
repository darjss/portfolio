---
import SocialIcon from './SocialIcon.astro';
import { socials } from '../data/site';

---

<!-- Start: Social Links -->
<div class="flex flex-wrap gap-3 mt-6 justify-between">

    {socials.map(social =>
        <a
            href={social.link}
            target={social.icon === 'github' ? '_blank' : undefined}
            title={social.title.en}
            data-title-en={social.title.en}
            data-title-mn={social.title.mn}
            data-i18n-title
            rel={social.icon === 'github' ? 'noopener noreferrer' : undefined}
            class="flex items-center justify-center w-10 h-10 rounded-lg ui-panel ui-text transition-all duration-150 border ui-border hover:bg-primary hover:text-white hover:-translate-y-0.5">
            <SocialIcon icon={social.icon} />
        </a>
    )}

</div>
<!-- End: Social Links -->
