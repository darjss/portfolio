---
import Socials from './Socials.astro';
import { terminalCopy, uiCopy } from '../data/site';
---

<div>

    <!-- Start: Terminal -->
    <div class="mt-6 ui-panel rounded-lg p-4 border ui-border text-xs">

        <div class="flex items-center mb-2">
            <span class="text-primary mr-2">$</span>
            <span class="ui-text">{terminalCopy.command}</span>
        </div>

        <div class="mt-2 ui-muted">
            <span data-i18n-field data-en={terminalCopy.initializing.en} data-mn={terminalCopy.initializing.mn}>{terminalCopy.initializing.en}</span>
            <br />
            <span data-i18n-field data-en={terminalCopy.ready.en} data-mn={terminalCopy.ready.mn}>{terminalCopy.ready.en}</span>
            <br />
            <span data-i18n-field data-en={terminalCopy.waiting.en} data-mn={terminalCopy.waiting.mn}>{terminalCopy.waiting.en}</span>
        </div>

    </div>
    <!-- End: Terminal -->

    <!-- Start: Social Links -->
    <Socials />
    <!-- End: Social Links -->

    <a
        href="/CV.pdf"
        download="Aviddaram-Bazarragchaa-CV.pdf"
        class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg border ui-border px-4 py-3 text-sm font-medium ui-text hover:text-primary hover:border-primary"
    >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        <span
            data-i18n-field
            data-en={uiCopy.cvDownload.en}
            data-mn={uiCopy.cvDownload.mn}
        >
            {uiCopy.cvDownload.en}
        </span>
    </a>

</div>
