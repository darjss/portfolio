{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "darjs-portfolio",
    "compatibility_date": "2026-02-11",
    "assets": {
        "directory": "./dist"
    },
    "routes": [
        {
            "pattern": "darjs.dev/*",
            "zone_name": "darjs.dev"
        },
        {
            "pattern": "www.darjs.dev/*",
            "zone_name": "darjs.dev"
        }
    ]
}
